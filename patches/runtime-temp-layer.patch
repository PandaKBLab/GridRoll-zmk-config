+// Mouse buttons and discrete encoder wheel events also renew the one-shot timeout.
+void zmk_input_processor_runtime_note_activity(const struct device *dev) {
+    struct runtime_processor_data *data = dev->data;
+    data->last_input_timestamp = k_uptime_get();
+    if (data->temp_layer_layer_active && !data->temp_layer_keep_active &&
+        data->temp_layer_held_positions == 0) {
+        k_work_reschedule(&data->temp_layer_deactivation_work,
+                          K_MSEC(data->temp_layer_deactivation_delay_ms));
+    }
+}
