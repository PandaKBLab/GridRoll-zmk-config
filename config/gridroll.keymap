// SPDX-License-Identifier: MIT
// Conventional Planck-style QWERTY / Lower / Raise, adapted to GridRoll's
// existing 47-key order. No QMK implementation code is included.
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors/runtime-input-processor.dtsi>
#define BASE 0
#define MOUSE 1
#define SYMBOLS 2
#define FUNCTION 3
/ {
    keymap {
        compatible = "zmk,keymap";
        base {
            display-name = "Base";
            bindings = <
                &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp BSPC
                &kp ESC &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                &kp LCTRL &kp LALT &kp LGUI &mkp MCLK &mo SYMBOLS &kp SPACE &kp RET &mo FUNCTION &kp LEFT &kp DOWN &kp RIGHT
            >;
            sensor-bindings = <&encoder_scroll>;
        };
        mouse {
            display-name = "Mouse";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &wheel_up &wheel_down &wheel_left &wheel_right &trans
                &to BASE &trans &trans &trans &trans &trans &mkp MCLK &mkp LCLK &mkp RCLK &mkp MB4 &mkp MB5 &trans
                &trans &trans &trans &trans &trans &trans &trans &mo FUNCTION &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &precision_quarter &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&encoder_scroll>;
        };
        symbols {
            display-name = "Symbols";
            bindings = <
                &kp TILDE &kp EXCL &kp AT &kp HASH &kp DOLLAR &kp PRCNT &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &trans
                &kp DEL &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp GRAVE
                &trans &kp LBKT &kp RBKT &kp LBRC &kp RBRC &kp PIPE &kp MINUS &kp EQUAL &kp PLUS &kp UNDER &kp BSLH &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&encoder_scroll>;
        };
        function {
            display-name = "Function";
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &to BASE &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &mkp MCLK &mkp LCLK &mkp RCLK &mkp MB4 &mkp MB5 &kp DEL
                &trans &bt BT_CLR &out OUT_USB &out OUT_BLE &studio_ble &to MOUSE &kp HOME &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp END
                &trans &trans &trans &kp C_MUTE &trans &trans &trans &trans &kp C_PREV &kp C_VOL_DN &kp C_VOL_UP
            >;
            sensor-bindings = <&encoder_volume>;
        };
        empty4 {
            display-name = "Empty 4";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none
            >;
            sensor-bindings = <&encoder_none>;
        };
        empty5 {
            display-name = "Empty 5";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none
            >;
            sensor-bindings = <&encoder_none>;
        };
        empty6 {
            display-name = "Empty 6";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none
            >;
            sensor-bindings = <&encoder_none>;
        };
        empty7 {
            display-name = "Empty 7";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none
            >;
            sensor-bindings = <&encoder_none>;
        };
    };
    behaviors {
        studio_ble: studio_ble {
            compatible = "gridroll,behavior-studio-ble";
            #binding-cells = <0>;
            display-name = "Studio BLE discover (60s)";
        };
        encoder_none: encoder_none {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&none>;
            ccw-binding = <&none>;
        };
        precision_quarter: precision_quarter {
            compatible = "gridroll,behavior-precision";
            #binding-cells = <0>;
            display-name = "Precision 0.25x (hold)";
            processor-name = "mouse";
        };
        wheel_down: wheel_down {
            compatible = "gridroll,behavior-wheel-step";
            #binding-cells = <0>;
            display-name = "wheel down";
            input-code = <INPUT_REL_WHEEL>;
            step = <(-1)>;
        };
        wheel_up: wheel_up {
            compatible = "gridroll,behavior-wheel-step";
            #binding-cells = <0>;
            display-name = "wheel up";
            input-code = <INPUT_REL_WHEEL>;
            step = <(1)>;
        };
        wheel_left: wheel_left {
            compatible = "gridroll,behavior-wheel-step";
            #binding-cells = <0>;
            display-name = "wheel left";
            input-code = <INPUT_REL_HWHEEL>;
            step = <(-1)>;
        };
        wheel_right: wheel_right {
            compatible = "gridroll,behavior-wheel-step";
            #binding-cells = <0>;
            display-name = "wheel right";
            input-code = <INPUT_REL_HWHEEL>;
            step = <(1)>;
        };
        encoder_scroll: encoder_scroll {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&wheel_up>;
            ccw-binding = <&wheel_down>;
        };
        encoder_volume: encoder_volume {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };
    };
    gridroll_scroll: gridroll_scroll {
        compatible = "zmk,input-processor-runtime";
        processor-label = "scroll";
        type = <INPUT_EV_REL>;
        x-codes = <INPUT_REL_X>;
        y-codes = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <60>;
        track-remainders;
        xy-to-scroll-enabled;
        #input-processor-cells = <0>;
    };
};
&mouse_runtime_input_processor {
    temp-layer-enabled;
    temp-layer = <MOUSE>;
    // Typing guard, not a requirement to keep moving for this duration.
    temp-layer-activation-delay-ms = <200>;
    temp-layer-deactivation-delay-ms = <1200>;
};
&trackball_listener {
    input-processors = <&mouse_runtime_input_processor>;
    scroll_layer {
        layers = <FUNCTION>;
        input-processors = <&gridroll_scroll>;
    };
};
