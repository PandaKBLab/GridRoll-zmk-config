// SPDX-License-Identifier: MIT
// Conventional Planck-style QWERTY / Lower / Raise, adapted to GridRoll's
// existing 47-key order. No QMK implementation code is included.
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors/runtime-input-processor.dtsi>
#define BASE 0
#define MOUSE 1
#define LOWER 2
#define NAV 3
#define RAISE 4
#define SCROLL 5
#define WIRELESS 6
#define SYSTEM 7
/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        system { if-layers = <LOWER RAISE>; then-layer = <SYSTEM>; };
    };
    keymap {
        compatible = "zmk,keymap";
        base {
            display-name = "Base";
            bindings = <
                &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp BSPC
                &kp ESC &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RET
                &kp LCTRL &kp LALT &kp LGUI &mkp MCLK &mo LOWER &kp SPACE &lt MOUSE SPACE &mo RAISE &kp LEFT &kp DOWN &kp RIGHT
            >;
            sensor-bindings = <&encoder_scroll>;
        };
        mouse {
            display-name = "Mouse";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &wheel_up &wheel_down &wheel_left &wheel_right &trans
                &to BASE &trans &trans &trans &trans &trans &mkp MCLK &mkp LCLK &mkp RCLK &mkp MB4 &mkp MB5 &trans
                &trans &trans &trans &trans &trans &trans &trans &mo SCROLL &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&encoder_scroll>;
        };
        lower {
            display-name = "Lower";
            bindings = <
                &kp TILDE &kp EXCL &kp AT &kp HASH &kp DOLLAR &kp PRCNT &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
                &kp DEL &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp UNDER &kp PLUS &kp LBRC &kp RBRC &kp PIPE
                &trans &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &kp HOME &kp PG_DN &kp UP &kp PG_UP &kp END
                &mo NAV &trans &trans &trans &trans &trans &mo SCROLL &trans &kp C_PREV &kp C_VOL_DN &kp C_VOL_UP
            >;
            sensor-bindings = <&encoder_scroll>;
        };
        nav {
            display-name = "Navigation";
            bindings = <
                &trans &trans &trans &trans &trans &trans &kp HOME &kp PG_DN &kp UP &kp PG_UP &kp END &kp BSPC
                &trans &trans &trans &trans &trans &trans &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp DEL &kp INS
                &trans &trans &trans &trans &trans &trans &kp LC(LEFT) &kp LC(DOWN) &kp LC(UP) &kp LC(RIGHT) &kp HOME &kp END
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&encoder_scroll>;
        };
        raise {
            display-name = "Raise";
            bindings = <
                &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSPC
                &kp DEL &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH
                &mo WIRELESS &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &kp C_NEXT &kp C_VOL_DN &kp C_VOL_UP
            >;
            sensor-bindings = <&encoder_volume>;
        };
        scroll {
            display-name = "Scroll";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &wheel_up &wheel_down &wheel_left &wheel_right &trans
                &trans &trans &trans &trans &trans &trans &mkp MCLK &mkp LCLK &mkp RCLK &mkp MB4 &mkp MB5 &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&encoder_scroll>;
        };
        wireless {
            display-name = "Wireless";
            bindings = <
                &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&encoder_scroll>;
        };
        system {
            display-name = "System";
            bindings = <
                &to BASE &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &out OUT_USB &out OUT_BLE &out OUT_TOG &trans &trans &bt BT_CLR
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &bootloader &sys_reset &trans &mkp MCLK &trans &trans &trans &trans &trans &sys_reset &bootloader
            >;
            sensor-bindings = <&encoder_volume>;
        };
    };
    behaviors {
        wheel_down: wheel_down {
            compatible = "gridroll,behavior-wheel-step";
            #binding-cells = <0>;
            display-name = "wheel down";
            input-code = <INPUT_REL_WHEEL>;
            step = <(-1)>;
        };
        wheel_up: wheel_up {
            compatible = "gridroll,behavior-wheel-step";
            #binding-cells = <0>;
            display-name = "wheel up";
            input-code = <INPUT_REL_WHEEL>;
            step = <(1)>;
        };
        wheel_left: wheel_left {
            compatible = "gridroll,behavior-wheel-step";
            #binding-cells = <0>;
            display-name = "wheel left";
            input-code = <INPUT_REL_HWHEEL>;
            step = <(-1)>;
        };
        wheel_right: wheel_right {
            compatible = "gridroll,behavior-wheel-step";
            #binding-cells = <0>;
            display-name = "wheel right";
            input-code = <INPUT_REL_HWHEEL>;
            step = <(1)>;
        };
        encoder_scroll: encoder_scroll {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&wheel_down>;
            ccw-binding = <&wheel_up>;
        };
        encoder_volume: encoder_volume {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };
    };
    gridroll_scroll: gridroll_scroll {
        compatible = "zmk,input-processor-runtime";
        processor-label = "scroll";
        type = <INPUT_EV_REL>;
        x-codes = <INPUT_REL_X>;
        y-codes = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <60>;
        track-remainders;
        xy-to-scroll-enabled;
        #input-processor-cells = <0>;
    };
};
&mouse_runtime_input_processor {
    temp-layer-enabled;
    temp-layer = <MOUSE>;
    // Typing guard, not a requirement to keep moving for this duration.
    temp-layer-activation-delay-ms = <200>;
    temp-layer-deactivation-delay-ms = <1200>;
};
&trackball_listener {
    input-processors = <&mouse_runtime_input_processor>;
    scroll_layer {
        layers = <SCROLL>;
        input-processors = <&gridroll_scroll>;
    };
};
