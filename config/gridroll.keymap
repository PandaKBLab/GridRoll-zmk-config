// SPDX-License-Identifier: MIT
// Layer defaults adapted for GridRoll from keyfreaks/zmk-config-LiNEA40,
// config/LiNEA40.keymap at 6953ccb2e2d6256ed57887fde692bcb1959f9052.
// Keep GridRoll's 47-key physical order; see docs/keymap.md for the adaptation.
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors/runtime-input-processor.dtsi>
#define BASE 0
#define MOUSE 1
#define SYMBOL 2
#define NAV 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6
#define SYSTEM 7
/ {
    combos {
        compatible = "zmk,combos";
        combo_grave { bindings = <&kp GRAVE>; key-positions = <14 15>; timeout-ms = <30>; layers = <BASE>; };
        combo_delete { bindings = <&kp DEL>; key-positions = <8 9>; timeout-ms = <30>; layers = <BASE>; };
        combo_insert { bindings = <&kp INS>; key-positions = <7 8>; timeout-ms = <30>; layers = <BASE>; };
        combo_middle_click { bindings = <&mkp MB3>; key-positions = <20 19>; timeout-ms = <30>; layers = <BASE>; };
        combo_right_click { bindings = <&mkp MB2>; key-positions = <21 20>; timeout-ms = <30>; layers = <BASE>; };
        combo_mouse_button4 { bindings = <&mkp MB4>; key-positions = <32 33>; timeout-ms = <30>; layers = <BASE>; };
        combo_mouse_button5 { bindings = <&mkp MB5>; key-positions = <31 32>; timeout-ms = <30>; layers = <BASE>; };
    };
    keymap {
        compatible = "zmk,keymap";
        base {
            display-name = "Base";
            bindings = <
                &lt SYSTEM TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp BSPC
                &mo MOUSE &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &lt SCROLL MINUS &mo NAV
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &mt RIGHT_SHIFT BACKSPACE &kp RET
                &mt LCTRL ESC &kp LEFT_WIN &mt LEFT_ALT GRAVE &kp INS &lt SCROLL ENTER &lt SYMBOL TAB &lt SYMBOL BACKSPACE &lt FUNCTION SPACE &lt WIRELESS RIGHT_BRACKET &kp BACKSLASH &mt RIGHT_SHIFT SLASH
            >;
            sensor-bindings = <&encoder_scroll>;
        };
        mouse {
            display-name = "Mouse";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &mkp MB1 &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&encoder_scroll>;
        };
        symbol {
            display-name = "Symbol";
            bindings = <
                &trans &kp EXCLAMATION &kp AT &kp HASH &kp DOLLAR &kp PERCENT &kp CARET &kp AMPERSAND &kp ASTERISK &kp LEFT_PARENTHESIS &kp LBKT &trans
                &trans &kp SLASH &kp KP_NUMBER_4 &kp KP_NUMBER_5 &kp SEMICOLON &kp SEMICOLON &kp C_MUTE &kp LS(LBKT) &kp RIGHT_BRACKET &kp BACKSLASH &kp EQUAL &trans
                &trans &mt LEFT_SHIFT KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp APOS &kp SQT &kp KP_EQUAL &kp INT3 &kp LS(RIGHT_BRACKET) &kp LS(BACKSLASH) &kp LS(INT1) &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &kp ASTERISK &kp LEFT_PARENTHESIS &kp LS(QUESTION)
            >;
            sensor-bindings = <&encoder_volume>;
        };
        nav {
            display-name = "Navigation";
            bindings = <
                &trans &trans &kp LC(LG(LEFT_ARROW)) &kp UP_ARROW &kp LC(LG(RIGHT_ARROW)) &trans &kp KP_MULTIPLY &kp NUMBER_7 &kp NUMBER_8 &kp NUMBER_9 &kp KP_PLUS &trans
                &trans &trans &kp LEFT_ARROW &kp DOWN &kp RIGHT_ARROW &trans &kp KP_SLASH &kp NUMBER_4 &kp NUMBER_5 &kp NUMBER_6 &kp KP_MINUS &trans
                &trans &kp HOME &kp PAGE_DOWN &kp END &kp PAGE_UP &trans &kp UNDER &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_3 &kp ENTER &trans
                &trans &trans &trans &trans &trans &trans &kp ENTER &kp NUMBER_0 &kp DOT &kp ENTER &kp QUESTION
            >;
            sensor-bindings = <&encoder_scroll>;
        };
        function {
            display-name = "Function";
            bindings = <
                &trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &trans &trans &kp LA(PRINTSCREEN) &trans &kp LC(LA(DELETE)) &trans
                &trans &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &trans &trans &kp LS(LG(S)) &trans &kp LC(LS(ESCAPE)) &trans
                &trans &trans &trans &trans &kp F11 &kp F12 &kp C_MUTE &trans &trans &trans &kp LC(LA(INS)) &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&encoder_scroll>;
        };
        scroll {
            display-name = "Scroll";
            bindings = <
                &trans &trans &kp LC(LG(LEFT_ARROW)) &kp UP_ARROW &kp LC(LG(RIGHT_ARROW)) &trans &kp KP_MULTIPLY &kp NUMBER_7 &kp NUMBER_8 &kp NUMBER_9 &kp KP_PLUS &trans
                &trans &trans &kp LEFT_ARROW &kp DOWN &kp RIGHT_ARROW &trans &kp KP_SLASH &kp NUMBER_4 &kp NUMBER_5 &kp NUMBER_6 &kp KP_MINUS &trans
                &trans &kp HOME &kp PAGE_DOWN &kp END &kp PAGE_UP &trans &kp UNDER &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_3 &kp ENTER &trans
                &trans &trans &trans &trans &trans &trans &trans &kp NUMBER_0 &kp NUMBER_0 &kp DOT &kp QUESTION
            >;
            sensor-bindings = <&encoder_arrows>;
        };
        wireless {
            display-name = "Wireless";
            bindings = <
                &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &bt BT_CLR &trans
                &trans &trans &trans &trans &trans &trans &bootloader &studio_unlock &trans &trans &bt BT_CLR_ALL
            >;
            sensor-bindings = <&encoder_horizontal>;
        };
        system {
            display-name = "System";
            bindings = <
                &to BASE &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &out OUT_USB &out OUT_BLE &out OUT_TOG &trans &trans &bt BT_CLR
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &bootloader &sys_reset &trans &kp C_MUTE &trans &trans &trans &trans &trans &sys_reset &bootloader
            >;
            sensor-bindings = <&encoder_volume>;
        };
    };
    behaviors {
        encoder_scroll: encoder_scroll {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };
        encoder_volume: encoder_volume {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };
        encoder_arrows: encoder_arrows {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp DOWN>;
            ccw-binding = <&kp UP>;
        };
        encoder_horizontal: encoder_horizontal {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp RIGHT>;
            ccw-binding = <&kp LEFT>;
        };
    };
    // Discoverable DYA processors; scroll mode follows LiNEA40's Scroll layer.
    gridroll_scroll: gridroll_scroll {
        compatible = "zmk,input-processor-runtime";
        processor-label = "scroll";
        type = <INPUT_EV_REL>;
        x-codes = <INPUT_REL_X>;
        y-codes = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <60>;
        track-remainders;
        xy-to-scroll-enabled;
        #input-processor-cells = <0>;
    };
};
&trackball_listener {
    input-processors = <&mouse_runtime_input_processor>;
    scroll_layer {
        layers = <SCROLL>;
        input-processors = <&gridroll_scroll>;
    };
};
